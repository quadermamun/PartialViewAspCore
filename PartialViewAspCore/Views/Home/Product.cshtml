@model  IEnumerable<Product>

<h2>Products</h2>

<div class="container">
    <div class="row">

        @foreach (var item in Model)
        {

            <div class="col-md-4">
                
                @* <partial name="_ProductPartialView" model="item" /> *@                
                @await Html.PartialAsync("_ProductPartialView", item)

            </div>

            
        }

    </div>

</div>